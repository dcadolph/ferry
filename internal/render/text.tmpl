{{define "analogy" -}}
{{head "Say it like this:"}}
{{strong (wrap .Analogy.Spoken)}}

{{head "What stands for what:"}}
{{range .Analogy.Mappings}}- {{.Analogy}} {{dim "->"}} {{.Real}}
{{else}}(none)
{{end}}
{{head "Where it breaks:"}}
{{wrap .Analogy.BreaksDown}}

{{dim (wrap (printf "World: %s" .Analogy.World))}}
{{end}}

{{define "work" -}}
{{$s := .Skeleton -}}
{{head "Skeleton:"}}
Players:
{{range $s.Players}}- {{.Name}}: {{.Role}}
{{else}}(none)
{{end -}}
{{wrap (printf "Constraint: %s" $s.Constraint)}}
{{wrap (printf "Tradeoff: %s" $s.Tradeoff)}}
{{wrap (printf "Cost of inaction: %s" $s.CostOfInaction)}}
{{wrap (printf "Decision: %s" $s.Decision)}}
{{wrap (printf "Point: %s" $s.Point)}}
Cause and effect:
{{range $i, $step := $s.Chain}}{{inc $i}}. {{$step}}
{{else}}(none)
{{end}}
{{head "Candidates:"}}
{{range $i, $c := .Checked -}}
{{if $i}}
{{end -}}
{{$c.Candidate.World}}
{{- if $c.Round}} (round {{$c.Round}}){{end -}}
: {{verdict $c.Kept}}, fit {{$c.Verdict.Fit}}
{{wrap $c.Candidate.Spoken}}
{{if $c.Verdict.Problems -}}
Problems:
{{range $c.Verdict.Problems}}- {{.}}
{{end -}}
{{else -}}
Problems: none
{{end -}}
{{else -}}
(none)
{{end -}}
{{with .Recheck}}
{{head "Polished analogy:"}} {{verdict .Kept}}, fit {{.Verdict.Fit}}
{{if not .Kept -}}
{{wrap .Candidate.Spoken}}
{{end -}}
{{if .Verdict.Problems -}}
Problems:
{{range .Verdict.Problems}}- {{.}}
{{end -}}
{{else -}}
Problems: none
{{end -}}
{{end -}}
{{end}}
