{{define "analogy" -}}
{{head "Say it like this:"}}
{{strong (wrap .Analogy.Spoken)}}

{{head "What stands for what:"}}
{{range .Analogy.Mappings}}- {{.Analogy}} {{dim "->"}} {{.Real}}
{{else}}(none)
{{end}}
{{head "Where it breaks:"}}
{{wrap .Analogy.BreaksDown}}

{{dim (wrap (printf "World: %s" .Analogy.World))}}
{{end}}

{{define "work" -}}
{{$s := .Skeleton -}}
{{head "Skeleton:"}}

{{sub "Players"}}
{{players $s.Players}}

{{field "Constraint" $s.Constraint}}
{{field "Tradeoff" $s.Tradeoff}}
{{field "Cost of inaction" $s.CostOfInaction}}
{{field "Decision" $s.Decision}}
{{field "Point" $s.Point}}

{{sub "Cause and effect"}}
{{steps $s.Chain}}

{{head "Candidates:"}}

{{if .Checked -}}
{{table .Checked}}
{{range .Checked}}
{{template "checked" .}}
{{- end}}
{{- else -}}
{{"  (none)"}}
{{end -}}
{{with .Recheck}}
{{head "Polished analogy:"}}

{{rule .}}
{{if not .Kept}}{{spoken .Candidate.Spoken}}

{{end -}}
{{problems .Verdict.Problems}}
{{end -}}
{{end}}

{{define "checked" -}}
{{rule .}}
{{spoken .Candidate.Spoken}}

{{problems .Verdict.Problems}}
{{end}}
